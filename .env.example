# ==============================================================================
# Pre-School Management System - Environment Variables for Vercel Deployment
# Configure these variables in the Vercel Dashboard (Project Settings > Environment Variables)
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Service Environment Variables (Required for 'backend' service)
# ------------------------------------------------------------------------------
# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/preschool_management?retryWrites=true&w=majority

# Secret key used for signing JWT authentication tokens (Must be a secure random string)
JWT_SECRET=your_production_jwt_secret_key_min_32_chars

# JWT expiration period (e.g., 7d, 24h)
JWT_EXPIRE=7d

# Environment mode (production on Vercel)
NODE_ENV=production

# Frontend Client URL(s) for CORS allowlist (comma-separated if multiple)
# NOTE: *.vercel.app origins are automatically accepted by the backend CORS policy.
CLIENT_URL=https://your-project.vercel.app

# ------------------------------------------------------------------------------
# Frontend Service Environment Variables (Optional for 'frontend' service)
# ------------------------------------------------------------------------------
# API Base URL (Defaults to '/api' for same-origin proxying via Vercel rewrites)
VITE_API_URL=/api
