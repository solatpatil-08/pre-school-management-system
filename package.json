{
  "name": "preschool-management-system",
  "version": "1.0.0",
  "description": "Production-Ready Pre-School Management System with React, Vite, Tailwind CSS, Express, and MongoDB",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:all": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "seed": "npm --prefix backend run seed",
    "build": "npm --prefix frontend run build",
    "build:frontend": "npm --prefix frontend run build",
    "test:atlas": "npm --prefix backend run test:atlas"
  },
  "keywords": [
    "preschool",
    "kindergarten",
    "daycare",
    "management-system",
    "react",
    "vite",
    "tailwind",
    "express",
    "mongodb"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
